# Generators

#1

def s_gen(n):
    for i in range (0, n):
        yield i ** 2

n = int(input())

for s in s_gen(n):
    print (s)

#2 

def even_numbers(n):
    for i in range(0, n + 1, 2):
        yield i

n = int(input("Введите n: "))

print(", ".join(map(str, even_numbers(n))))

#3

def multiples_of_3_and_4(n):
    for i in range(n + 1):
        if i % 3 == 0 and i % 4 == 0:
            yield i 

n = int(input("Введите n: "))


for num in multiples_of_3_and_4(n):
    print(num, end=" ")


#4

def squares(a, b):
    for i in range(a, b + 1):
        yield i ** 2 

a = int(input("Введите a: "))
b = int(input("Введите b: "))

for square in squares(a, b):
    print(square, end=" ")

#5

def countdown(n):
    for i in range(n, -1, -1):
        yield i 

n = int(input("Введите n: "))

for num in countdown(n):
    print(num, end=" ")

